# dependencies
node_modules/

# build
dist/
dist-ssr/
*.local
*.tsbuildinfo

# env — 공개 VITE_* 포함 모든 실제 값 커밋 금지(§10.1). .env.example만 커밋.
.env
.env.*
!.env.example

# test / coverage
coverage/
playwright-report/
test-results/
.vitest/

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# supabase
supabase/.branches/
supabase/.temp/

# Capacitor 네이티브 빌드 캐시(프로젝트 ios/·android/는 커밋, 빌드 산출물만 무시)
/ios/App/Pods
/ios/App/build
/android/.gradle
/android/app/build
/android/build

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude에게 보여주려고 두는 참고 이미지(다른 앱 스크린샷 등) — 개인정보가 섞이므로 커밋하지 않는다.
/claude-image/

# TestFlight 아카이브(용량 큼)와 API 키 설정 — 커밋 금지
.release/
.env.release

# App Store Connect API 비밀키 — 저장소에 절대 들어오면 안 된다.
# 실제로 브라우저가 저장소 안(appstoreconnect/private_keys/)에 떨어뜨린 적이 있어 방어선을 둔다.
*.p8
AuthKey_*
appstoreconnect/
